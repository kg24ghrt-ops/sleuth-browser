<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory app:title="@string/pref_appearance">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="dark_pages"
            app:summary="@string/pref_dark_mode_summary"
            app:title="@string/pref_dark_mode" />
        <SeekBarPreference
            app:defaultValue="100"
            android:max="200"
            app:key="font_scale"
            app:min="50"
            app:showSeekBarValue="true"
            app:title="@string/pref_font_size" />
        <ListPreference
            app:defaultValue="duckduckgo"
            app:entries="@array/search_engine_entries"
            app:entryValues="@array/search_engine_values"
            app:key="search_engine"
            app:title="@string/pref_search_engine"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_behaviour">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="javascript"
            app:summary="@string/pref_javascript_summary"
            app:title="@string/pref_javascript" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="cookies"
            app:summary="@string/pref_cookies_summary"
            app:title="@string/pref_cookies" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="block_trackers"
            app:summary="@string/pref_block_trackers_summary"
            app:title="@string/pref_block_trackers" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="mixed_content"
            app:summary="@string/pref_mixed_content_summary"
            app:title="@string/pref_mixed_content" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="geolocation"
            app:summary="@string/pref_geolocation_summary"
            app:title="@string/pref_geolocation" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="desktop_mode"
            app:title="@string/pref_desktop" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="save_to_gallery"
            app:summary="@string/pref_save_shots_summary"
            app:title="@string/pref_save_shots" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_speed">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="lite_mode"
            app:summary="@string/pref_lite_mode_summary"
            app:title="@string/pref_lite_mode" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="prewarm"
            app:summary="@string/pref_prewarm_summary"
            app:title="@string/pref_prewarm" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pause_background"
            app:summary="@string/pref_pause_summary"
            app:title="@string/pref_pause" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="safe_browsing"
            app:summary="@string/pref_safe_browsing_summary"
            app:title="@string/pref_safe_browsing" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_data">
        <Preference
            app:key="clear_history"
            app:title="@string/pref_clear_history" />
        <Preference
            app:key="clear_cache"
            app:title="@string/pref_clear_cache" />
        <Preference
            app:key="clear_all"
            app:title="@string/pref_clear_all" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_about">
        <Preference
            app:key="version"
            app:selectable="false"
            app:title="@string/pref_version" />
    </PreferenceCategory>

</PreferenceScreen>
